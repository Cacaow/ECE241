`timescale 1ns / 1ps
`default_nettype none

module part4	(
	input wire CLOCK_50,            //On Board 50 MHz
	input wire [9:0] SW,            // On board Aitches
	input wire [3:0] KEY,           // On board push buttons
	output wire [6:0] HEX0,         // HEX displays
	output wire [6:0] HEX1,         
	output wire [6:0] HEX2,         
	output wire [6:0] HEX3,         
	output wire [6:0] HEX4,         
	output wire [6:0] HEX5,         
	output wire [9:0] LEDR,         // LEDs
	output wire [7:0] x,            // VGA pixel coordinates
	output wire [6:0] y,
	output wire [2:0] colour,       // VGA pixel colour (0-7)
	output wire plot,               // Pixel drawn when this is pulsed
	output wire vga_resetn          // VGA resets to black when this is pulsed (NOT CURRENTLY AVAILABLE)
);    

	//Write code in here!
	/*Logic:
		Comparator checks if input V is >9 or not
		If greater than 9, Multiplexer uses Circuit A path, where circuit A does V - 10
		If less than 9, directly take V
		d1 shows comparator results, d0 shows the number
	*/
	
	assign LEDR[3:0] = SW[3:0];
	//binary number
	wire [3:0]V = SW[3:0];
	
	//comparator -> V > 9 when 1010+
	wire z = V[3] && (V[2] || V[1]);
	
	/*Circuit A -> A = V - 10 when V > 9
	  V     A
    1010  0000
    1011  0001
    1100  0010
    1101  0011
    1110  0100
    1111  0101
	*/
	wire [3:0] A;
	assign A[3] = 1'b0;
	assign A[2] = V[2] & V[1];
	assign A[1] = V[2] & ~V[1];
	assign A[0] = V[0];
	
	//multiplexer 2 to 1
	wire[3:0] M;
	assign M[0] = (~z && V[0]) || (z && A[0]);
	assign M[1] = (~z && V[1]) || (z && A[1]);
	assign M[2] = (~z && V[2]) || (z && A[2]);
	assign M[3] = (~z && V[3]) || (z && A[3]);
	
	//
	wire [3:0]d1, d0;
	//concatinate into 000z to make 4 bit input (z is 1 bit)
	assign d1 = {3'b000, z};
	assign d0 = M;
	
	
	seg7 H0 (d0, HEX0);
	seg7 H1 (d1, HEX1);
	
endmodule

module seg7 (
	input wire [3:0]A,
	output wire [6:0]Display
	);

	assign Display[0] = (~A[3] && ~A[1]) && ((A[2] && ~A[0]) || (A[0] && ~A[2]));
	assign Display[1] = (A[2] && ~A[3]) && ((A[0] && ~A[1]) || (~A[0] && A[1]));
	assign Display[2] = ~A[3] && ~A[2] && A[1] && ~A[0];
	assign Display[3] = ((~A[3] && ~A[1]) && ((A[2] && ~A[0]) || (A[0] && ~A[2]))) || (~A[3] && A[2] && A[1] && A[0]);
	assign Display[4] = A[0] || (~A[3] && A[2] && ~A[1]);
	assign Display[5] = ~A[3] && ((~A[2] && (A[1] || A[0])) || (A[2] && A[1] && A[0]));
	assign Display[6] = ~A[3] && ((~A[2] && ~A[1]) || (A[2] && A[1] && A[0]));

endmodule